# Copy to .env and fill in. Never commit .env.

# development | test | production
NODE_ENV=development
PORT=3000
# 127.0.0.1 = only reachable from this machine (use behind nginx on Vultr).
# 0.0.0.0   = reachable from the network.
HOST=127.0.0.1
DATABASE_PATH=./data/sidequest.db
# Comma-separated browser origins allowed to call the API. "https://*.lovable.app" matches any subdomain.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,https://*.lovable.app
# Set to true when running behind a reverse proxy (nginx) so client IPs are read correctly.
TRUST_PROXY=false
# debug | info | warn | error | silent
LOG_LEVEL=info

# --- Auth -------------------------------------------------------------------
# auth0 (default, required in production) | dev (LOCAL ONLY, requires NODE_ENV=development;
# accepts "Authorization: Bearer dev:<name>" without verification)
AUTH_MODE=auth0
# Your Auth0 tenant URL, e.g. https://dev-abc123.us.auth0.com/
AUTH0_ISSUER_BASE_URL=
# The "Identifier" of the Auth0 API you created, e.g. https://api.ubc-sidequest
AUTH0_AUDIENCE=

# --- Maritime AI agent (Person 3) ---------------------------------------------
# Leave empty to always use built-in fallback quests.
MARITIME_AGENT_URL=
# Sent as "Authorization: Bearer <key>" to the agent. Optional.
MARITIME_API_KEY=
MARITIME_TIMEOUT_MS=10000

# --- n8n webhook (Person 4) ---------------------------------------------------
# Leave empty to disable event delivery.
N8N_WEBHOOK_URL=
# Sent as the "X-SideQuest-Secret" header; configure n8n Webhook "Header Auth" to check it.
N8N_WEBHOOK_SECRET=
N8N_TIMEOUT_MS=5000
OUTBOX_POLL_INTERVAL_MS=15000
OUTBOX_MAX_ATTEMPTS=8

# --- Matchmaking --------------------------------------------------------------
# After this many seconds in the queue, users can be matched without a shared interest.
MATCH_RELAX_AFTER_SECONDS=45
